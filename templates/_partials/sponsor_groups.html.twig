{% for group in sponsor_groups %}
    <section class="sponsor-tier sponsor-tier--{{ group.tier.value }}">
        <h3>{{ group.tier.label }}</h3>
        <ul class="sponsor-logos">
            {% for sponsor in group.sponsors %}
                <li>
                    <a href="{{ sponsor.websiteUrl }}" rel="noopener sponsored" target="_blank" title="{{ sponsor.name }}">
                        {% if sponsor.logoPath %}
                            <img src="{{ sponsor.logoPath }}" alt="{{ sponsor.name }}">
                        {% else %}
                            <span>{{ sponsor.name }}</span>
                        {% endif %}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </section>
{% else %}
    <p class="empty">Nos premiers commanditaires seront bientôt annoncés.</p>
{% endfor %}
