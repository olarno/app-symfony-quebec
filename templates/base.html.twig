<!DOCTYPE html>
<html lang="fr-CA">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="dark">
        <title>{% block title %}Symfony Québec{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}Symfony Québec organise, facilite et promeut la présence de Symfony au Québec et au Canada : meetups, conférences, cercle de professionnels.{% endblock %}">
        <link rel="icon" href="{{ asset('favicon.svg') }}" type="image/svg+xml">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        {% set route = app.current_route %}
        <header class="site-header">
            <div class="container site-header__inner">
                <a class="brand" href="{{ path('app_home') }}">
                    <span class="brand__logo">{{ include('_partials/fleur.svg.twig') }}</span>
                    <span class="brand__name">Symfony <strong>Québec</strong></span>
                </a>
                <nav class="site-nav" aria-label="Navigation principale">
                    <a href="{{ path('app_event_index') }}" {{ route starts with 'app_event' ? 'aria-current="page"' }}>Événements</a>
                    <a href="{{ path('app_sponsor_index') }}" {{ route == 'app_sponsor_index' ? 'aria-current="page"' }}>Commanditaires</a>
                    <a href="{{ path('app_team_index') }}" {{ route == 'app_team_index' ? 'aria-current="page"' }}>Équipe</a>
                    <a href="{{ path('app_apps_index') }}" {{ route == 'app_apps_index' ? 'aria-current="page"' }}>Carte</a>
                    <a class="button button--small" href="{{ path('app_contact') }}">Contact</a>
                </nav>
            </div>
        </header>

        <main>
            {% for type, messages in app.flashes %}
                <div class="container">
                    {% for message in messages %}
                        <p class="flash flash--{{ type }}" role="status">{{ message }}</p>
                    {% endfor %}
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container site-footer__inner">
                <div>
                    <a class="brand" href="{{ path('app_home') }}">
                        <span class="brand__logo">{{ include('_partials/fleur.svg.twig') }}</span>
                        <span class="brand__name">Symfony <strong>Québec</strong></span>
                    </a>
                    <p class="muted">Organiser, faciliter et promouvoir Symfony au Québec et au Canada.</p>
                </div>
                <nav class="site-footer__nav" aria-label="Pied de page">
                    <div>
                        <h2>Communauté</h2>
                        <a href="{{ path('app_event_index') }}">Événements</a>
                        <a href="{{ path('app_team_index') }}">Équipe</a>
                        <a href="{{ map_url }}" rel="noopener" target="_blank">Carte interactive</a>
                    </div>
                    <div>
                        <h2>Participer</h2>
                        <a href="{{ path('app_sponsor_index') }}#devenir-commanditaire">Devenir commanditaire</a>
                        <a href="{{ path('app_contact', {sujet: 'conference'}) }}">Inviter un conférencier</a>
                        <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                    </div>
                </nav>
            </div>
            <div class="container site-footer__bottom">
                <p class="muted small">© {{ 'now'|date('Y') }} Symfony Québec — communauté indépendante. Symfony est une marque déposée de Symfony SAS.</p>
            </div>
        </footer>
    </body>
</html>
