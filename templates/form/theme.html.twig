{% use 'form_div_layout.html.twig' %}

{%- block form_row -%}
    <div class="form-row{{ errors|length ? ' form-row--error' }}">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row -%}

{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="form-errors">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}

{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="choice-list">
        {%- for child in form %}
            <label class="choice">
                {{- form_widget(child) -}}
                <span>{{ child.vars.label }}</span>
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}
